<?xml version = "1.0"?>
<robot name="drone" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find realsense2_description)/urdf/_d435i.urdf.xacro" />
    <!-- NO incluyas drone_gazebo.xacro -->
    
    <link name="base_footprint"/>
    
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="file://$(find drone_description)/meshes/iris.dae" scale="1 1 1" />
            </geometry>
            <material name="blue">
                <color rgba="0 0 0.7 1" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 -0.03" rpy="0 0 0" />
            <geometry>
                <box size="0.47 0.47 0.15" />        
            </geometry>
        </collision>
        <inertial>
            <mass value="1.5" />
            <origin xyz="0 0 0" />
            <inertia ixx="0.0347563" ixy="0.0" ixz="0.0" 
                     iyy="0.07" iyz="0.0" izz="0.0977" />
        </inertial>
    </link>
    
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <!-- Rotor 0 -->
    <link name="rotor_0_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="file://$(find drone_description)/meshes/propeller_ccw.dae" scale="0.1 0.1 0.1"/>
            </geometry>
            <material name="red">
                <color rgba="1 0 0 1" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.1" length="0.005" />
            </geometry>
        </collision>
        <inertial>
            <mass value="0.005" />
            <origin xyz="0 0 0" />
            <inertia ixx="9.75e-07" ixy="0.0" ixz="0.0" 
                     iyy="4.17041e-05" iyz="0.0" izz="4.26041e-05" />
        </inertial>
    </link>
    
    <joint name="base_rotor_0_joint" type="fixed">
        <parent link="base_link" />
        <child link="rotor_0_link" />
        <origin xyz="0.13 -0.22 0.023" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <dynamics damping="0.1" friction="0.0" />
    </joint>

    <!-- Rotor 1 -->
    <link name="rotor_1_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="file://$(find drone_description)/meshes/propeller_ccw.dae" scale="0.1 0.1 0.1"/>
            </geometry>
            <material name="red">
                <color rgba="1 0 0 1" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.1" length="0.005" />
            </geometry>
        </collision>
        <inertial>
            <mass value="0.005" />
            <origin xyz="0 0 0" />
            <inertia ixx="9.75e-07" ixy="0.0" ixz="0.0" 
                     iyy="4.17041e-05" iyz="0.0" izz="4.26041e-05" />
        </inertial>
    </link>
    
    <joint name="base_rotor_1_joint" type="fixed">
        <parent link="base_link" />
        <child link="rotor_1_link" />
        <origin xyz="-0.13 0.2 0.023" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <dynamics damping="0.1" friction="0.0" />
    </joint>

    <!-- Rotor 2 -->
    <link name="rotor_2_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="file://$(find drone_description)/meshes/propeller_ccw.dae" scale="0.1 0.1 0.1"/>
            </geometry>
            <material name="red">
                <color rgba="1 0 0 1" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.1" length="0.005" />
            </geometry>
        </collision>
        <inertial>
            <mass value="0.005" />
            <origin xyz="0 0 0" />
            <inertia ixx="9.75e-07" ixy="0.0" ixz="0.0" 
                     iyy="4.17041e-05" iyz="0.0" izz="4.26041e-05" />
        </inertial>
    </link>
    
    <joint name="base_rotor_2_joint" type="fixed">
        <parent link="base_link" />
        <child link="rotor_2_link" />
        <origin xyz="0.13 0.22 0.023" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <dynamics damping="0.1" friction="0.0" />
    </joint>

    <!-- Rotor 3 -->
    <link name="rotor_3_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="file://$(find drone_description)/meshes/propeller_ccw.dae" scale="0.1 0.1 0.1"/>
            </geometry>
            <material name="red">
                <color rgba="1 0 0 1" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.1" length="0.005" />
            </geometry>
        </collision>
        <inertial>
            <mass value="0.005" />
            <origin xyz="0 0 0" />
            <inertia ixx="9.75e-07" ixy="0.0" ixz="0.0" 
                     iyy="4.17041e-05" iyz="0.0" izz="4.26041e-05" />
        </inertial>
    </link>
    
    <joint name="base_rotor_3_joint" type="fixed">
        <parent link="base_link" />
        <child link="rotor_3_link" />
        <origin xyz="-0.13 -0.2 0.023" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <dynamics damping="0.1" friction="0.0" />
    </joint>


    <!-- camara -->
    <xacro:sensor_d435i parent="base_link" name="d435i" use_nominal_extrinsics="true" > 
        <!-- tengo que cambiar el origen de la camara :)-->
        <origin xyz="0.10 0 -0.040" rpy="0 0 0" /> 
    </xacro:sensor_d435i>
</robot>